{
  "name": "votedel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API VoteDel - sistem pemilihan suara online mahasiswa (Express.js + SQLite)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/database/seedCli.js",
    "test": "node --test",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
