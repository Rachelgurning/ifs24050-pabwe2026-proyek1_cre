# Salin menjadi .env lalu sesuaikan nilainya.
NODE_ENV=development
PORT=8000
# WAJIB diganti di production (minimal 32 karakter acak)
JWT_SECRET=12345678912345678912345678912345
JWT_EXPIRES_IN=8h
DB_PATH=data/votedel.sqlite
# Daftar origin frontend yang diizinkan, pisahkan dengan koma
# Produksi (Vercel): isi dengan URL frontend, contoh https://nama-fe.vercel.app
CORS_ORIGINS=http://localhost:3000
# Set true jika berjalan di belakang reverse proxy (Render, Railway, Nginx)
TRUST_PROXY=false
# Isi data demo otomatis ketika database masih kosong
SEED_ON_START=true
ADMIN_PASSWORD=Admin#12345
